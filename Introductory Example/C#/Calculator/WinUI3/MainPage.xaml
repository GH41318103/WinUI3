<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUI3.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUI3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!-- 移除 Viewbox 與固定寬高，讓 Grid 100% 撐滿任何視窗尺寸 -->
    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.8*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 專業顯示螢幕區塊 -->
        <Border Grid.Row="0" Grid.ColumnSpan="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="4,4,4,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 上方算式顯示 -->
                <TextBlock x:Name="ExpressionText"
                           Grid.Row="0"
                           FontSize="20"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"/>

                <!-- 下方主數字顯示（Viewbox 讓大數字在視窗拉高時也能跟著變大） -->
                <Viewbox Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxHeight="80">
                    <TextBlock x:Name="DisplayText"
                               Text="0"
                               FontSize="48"
                               FontWeight="Bold"/>
                </Viewbox>
            </Grid>
        </Border>

        <!-- 第一排：C, 退格, Ans, ÷ -->
        <Button Content="C" Click="Clear_Click" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" FontSize="22"/>
        <Button Content="⌫" Click="Backspace_Click" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" FontSize="22"/>
        <Button Content="Ans" Click="Ans_Click" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" FontSize="22"/>
        <Button Content="÷" Click="Operator_Click" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" FontSize="26"/>

        <!-- 第二排：7, 8, 9, × -->
        <Button Content="7" Click="Number_Click" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" FontSize="24"/>
        <Button Content="8" Click="Number_Click" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" FontSize="24"/>
        <Button Content="9" Click="Number_Click" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" FontSize="24"/>
        <Button Content="×" Click="Operator_Click" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" FontSize="26"/>

        <!-- 第三排：4, 5, 6, - -->
        <Button Content="4" Click="Number_Click" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" FontSize="24"/>
        <Button Content="5" Click="Number_Click" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" FontSize="24"/>
        <Button Content="6" Click="Number_Click" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" FontSize="24"/>
        <Button Content="-" Click="Operator_Click" Grid.Row="3" Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" FontSize="26"/>

        <!-- 第四排：1, 2, 3, + -->
        <Button Content="1" Click="Number_Click" Grid.Row="4" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" FontSize="24"/>
        <Button Content="2" Click="Number_Click" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" FontSize="24"/>
        <Button Content="3" Click="Number_Click" Grid.Row="4" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" FontSize="24"/>
        <Button Content="+" Click="Operator_Click" Grid.Row="4" Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" FontSize="26"/>

        <!-- 第五排：0, 小數點, = -->
        <Button Content="0" Click="Number_Click" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" FontSize="24"/>
        <Button Content="." Click="Number_Click" Grid.Row="5" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" FontSize="24"/>
        <Button Content="=" Click="Equals_Click" Grid.Row="5" Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" FontSize="26" Style="{StaticResource AccentButtonStyle}"/>
    </Grid>
</Page>
