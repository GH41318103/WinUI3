<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Notebook.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Notebook"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="34,28,34,30" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock Text="Quick notes" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="NewNoteButton" HorizontalAlignment="Right" Click="NewNoteButton_Click"
                    Padding="14,8" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="22"/>
                    <TextBlock Text="New note" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <GridView x:Name="NotesGrid" IsItemClickEnabled="True" SelectionMode="Single"
                      ItemClick="NotesGrid_ItemClick" ItemsSource="{x:Bind Notes}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="300" ItemHeight="220"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,16,16"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Setter Property="ContextFlyout">
                            <Setter.Value>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Edit" Tag="edit" Click="NoteMenuItem_Click"/>
                                    <MenuFlyoutItem Text="Delete" Tag="delete" Click="NoteMenuItem_Click"/>
                                </MenuFlyout>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:NoteModel">
                        <Grid Padding="14,16,14,12" Background="#F7F7F7" CornerRadius="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontSize="18" LineHeight="24"
                                       Foreground="#202020" TextTrimming="CharacterEllipsis" MaxLines="5"/>
                            <TextBlock Grid.Row="1" Text="{x:Bind ModifiedText}" FontSize="14"
                                       Foreground="#666666" Margin="0,10,0,0"/>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>
    </Grid>
</Page>
